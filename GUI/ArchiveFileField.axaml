<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="420"
             x:Class="ImapCopy.ArchiveFileField">
    <Grid ColumnDefinitions="Auto,*,Auto">
        <TextBlock Name="LabelText" Grid.Column="0" VerticalAlignment="Center" Width="90"/>
        <TextBox Name="FileNameBox" Grid.Column="1" Watermark="path to backup .7z file" Margin="0,0,8,0"/>
        <Button Name="BrowseButton" Grid.Column="2" Content="Browse..." Click="BrowseButton_Click"/>
    </Grid>
</UserControl>
