<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="using:ImapCopy"
        mc:Ignorable="d" d:DesignWidth="640" d:DesignHeight="440"
        x:Class="ImapCopy.MainWindow"
        Width="640" Height="440" MinWidth="520" MinHeight="380"
        Icon="/Resources/sync-envelope.ico"
        Title="ImapCopy">
    <Grid RowDefinitions="*,Auto" Margin="12">

        <TabControl Grid.Row="0">

            <TabItem Header="Copy">
                <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Margin="8">
                    <TextBlock Grid.Row="0" Text="Copies every message from the source mailbox to the destination mailbox." TextWrapping="Wrap" Opacity="0.7" Margin="0,0,0,12"/>

                    <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                        <local:ImapUrlField Name="CopySourceField" Grid.Column="0" Label="Source:" Margin="0,0,8,0"/>
                        <Button Name="CopySourceTestButton" Grid.Column="1" Content="Test" Click="CopySourceTestButton_Click"/>
                    </Grid>

                    <Grid Grid.Row="2" ColumnDefinitions="*,Auto">
                        <local:ImapUrlField Name="CopyDestField" Grid.Column="0" Label="Destination:" Margin="0,0,8,0"/>
                        <Button Name="CopyDestTestButton" Grid.Column="1" Content="Test" Click="CopyDestTestButton_Click"/>
                    </Grid>

                    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Name="CopyStartButton" Content="Copy" Click="CopyButton_Click"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Update">
                <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Margin="8">
                    <TextBlock Grid.Row="0" Text="Like Copy, but also syncs flags and removes destination messages that no longer exist in the source." TextWrapping="Wrap" Opacity="0.7" Margin="0,0,0,12"/>

                    <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                        <local:ImapUrlField Name="UpdateSourceField" Grid.Column="0" Label="Source:" Margin="0,0,8,0"/>
                        <Button Name="UpdateSourceTestButton" Grid.Column="1" Content="Test" Click="UpdateSourceTestButton_Click"/>
                    </Grid>

                    <Grid Grid.Row="2" ColumnDefinitions="*,Auto">
                        <local:ImapUrlField Name="UpdateDestField" Grid.Column="0" Label="Destination:" Margin="0,0,8,0"/>
                        <Button Name="UpdateDestTestButton" Grid.Column="1" Content="Test" Click="UpdateDestTestButton_Click"/>
                    </Grid>

                    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Name="UpdateStartButton" Content="Update" Click="UpdateButton_Click"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Backup">
                <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Margin="8">
                    <TextBlock Grid.Row="0" Text="Writes every message from the source mailbox into a .7z backup archive." TextWrapping="Wrap" Opacity="0.7" Margin="0,0,0,12"/>

                    <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                        <local:ImapUrlField Name="BackupSourceField" Grid.Column="0" Label="Source:" Margin="0,0,8,0"/>
                        <Button Name="BackupSourceTestButton" Grid.Column="1" Content="Test" Click="BackupSourceTestButton_Click"/>
                    </Grid>

                    <local:ArchiveFileField Name="BackupFileField" Grid.Row="2" Label="Backup file:" MustExist="False"/>

                    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Name="BackupStartButton" Content="Backup" Click="BackupButton_Click"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Restore">
                <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Margin="8">
                    <TextBlock Grid.Row="0" Text="Restores every message from a .7z backup archive into the destination mailbox." TextWrapping="Wrap" Opacity="0.7" Margin="0,0,0,12"/>

                    <local:ArchiveFileField Name="RestoreFileField" Grid.Row="1" Label="Backup file:" MustExist="True" Margin="0,0,0,8"/>

                    <Grid Grid.Row="2" ColumnDefinitions="*,Auto">
                        <local:ImapUrlField Name="RestoreDestField" Grid.Column="0" Label="Destination:" Margin="0,0,8,0"/>
                        <Button Name="RestoreDestTestButton" Grid.Column="1" Content="Test" Click="RestoreDestTestButton_Click"/>
                    </Grid>

                    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Name="RestoreStartButton" Content="Restore" Click="RestoreButton_Click"/>
                    </StackPanel>
                </Grid>
            </TabItem>

        </TabControl>

        <StackPanel Grid.Row="1" Margin="0,12,0,0" Spacing="6">
            <ProgressBar Name="ProgressBarControl" Minimum="0" Maximum="1" Height="16"/>
            <TextBlock Name="StatusText" Text="Ready" TextWrapping="Wrap"/>
        </StackPanel>

    </Grid>
</Window>
